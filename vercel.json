{
  "functions": {
    "api/ask.ts": { "maxDuration": 30, "includeFiles": "public/data/**" },
    "api/power.ts": { "maxDuration": 15 }
  },
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
