# Copier en .env et remplir. Ne jamais commiter .env
EARTHDATA_TOKEN=

# Ask Terra. Laisser vide : AI Gateway utilise le jeton OIDC du projet.
# Ne pas ajouter AI_GATEWAY_API_KEY : une clé, même vide, prend le pas sur OIDC.
# Si cette variable est définie sur le serveur Vercel, Ask Terra appelle Gemini directement.
# Elle ne doit jamais être lue par le navigateur.
GOOGLE_GENERATIVE_AI_API_KEY=
